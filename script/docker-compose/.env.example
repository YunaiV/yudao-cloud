# 复制为 .env 后修改：cp .env.example .env
# 以下密码、令牌仅为示例，部署前请替换；.env 已被 .gitignore 忽略，不要提交

## 前端 Nginx 对宿主机开放的端口
WEB_PORT=8080

## 后端镜像 tag（每次重新打包后可修改，便于回滚）
IMAGE_TAG=local

## MySQL（首次初始化时生效，已有数据卷后修改不会改变库内账号密码）
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=Root@ChangeMe2026
MYSQL_USER=yudao
MYSQL_PASSWORD=Yudao@ChangeMe2026

## Redis
REDIS_PASSWORD=Redis@ChangeMe2026

## 后端应用
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx512m
# 需与前端打包时的 VITE_APP_CAPTCHA_ENABLE 一致
YUDAO_CAPTCHA_ENABLE=true

## Nacos
# 使用内置 Nacos：保持 COMPOSE_PROFILES=nacos、NACOS_SERVER_ADDR=nacos:8848
# 复用已部署的 Nacos：清空 COMPOSE_PROFILES，并把 NACOS_SERVER_ADDR 改为容器可访问的地址（同时需放通 8848、9848）
COMPOSE_PROFILES=nacos
NACOS_SERVER_ADDR=nacos:8848
# 命名空间 ID（不是名称），需已存在；内置 Nacos 使用 public
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 已部署的 Nacos 开启鉴权时填写
NACOS_USERNAME=
NACOS_PASSWORD=

## 内置 Nacos 启动参数（仅 COMPOSE_PROFILES=nacos 时使用）
# NACOS_AUTH_TOKEN 为 32 位以上字符串的 Base64 编码，可用 openssl rand -base64 32 生成
NACOS_AUTH_TOKEN=eXVkYW8tY2xvdWQtbG9jYWwtbmFjb3MtdG9rZW4tY2hhbmdlLW1l
NACOS_AUTH_IDENTITY_KEY=yudao-identity
NACOS_AUTH_IDENTITY_VALUE=Identity@ChangeMe2026
